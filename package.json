{
  "name": "niulai-escape",
  "version": "2026.8.22",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "native:sync": "npm run build && cap sync",
    "ios:open": "cap open ios",
    "android:open": "cap open android",
    "ios:build": "./scripts/build-ios-simulator.sh",
    "ios:archive": "./scripts/build-ios-archive.sh",
    "android:build": "./scripts/build-android.sh",
    "mac:build": "npm run build && electron-builder --mac dmg zip --universal",
    "mac:dir": "npm run build && electron-builder --mac dir --universal"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "three": "^0.179.1",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "net.kryso.cowcome.mac",
    "productName": "牛来：雾中逃亡",
    "buildVersion": "20260822.30",
    "asar": true,
    "directories": {
      "output": "native-build/macos"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "WAWE LLC (GYD232NJLH)",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Cowcome-20260822.30-${arch}.${ext}",
      "title": "牛来：雾中逃亡 20260822.30"
    },
    "artifactName": "Cowcome-20260822.30-${arch}.${ext}",
    "npmRebuild": false
  },
  "description": "牛来：雾中逃亡——离线恐怖生存逃亡游戏",
  "author": "白河愁"
}
